[flake8]
select = ANN,B,B9,C,D,E,F,W,I
ignore = ANN101,ANN102,ANN401,B905,B950,D100,D102,D103,D104,D107,E203,E501,I001,I005,W503,W606
exclude =
  test/data/column.py
max-line-length = 88
docstring-convention = google
application-import-names = austin
per-file-ignores =
  test/*:ANN,D
  noxfile.py:ANN,D
